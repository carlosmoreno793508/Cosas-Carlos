# Manifiesto del canal Roku de MoreTV.
# Roku usa BrightScript + SceneGraph (no JavaScript), por eso este cliente
# reimplementa la lógica del núcleo (parser M3U y cliente Xtream) en BrightScript.
title=MoreTV
major_version=0
minor_version=1
build_version=0

# Iconos y splash (reemplaza los PNG en images/ por los de la marca MoreTV).
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
mm_icon_focus_fhd=pkg:/images/icon_focus_fhd.png
splash_screen_hd=pkg:/images/splash_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_color=#0f1116
splash_min_time=500

ui_resolutions=fhd

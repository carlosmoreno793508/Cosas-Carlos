<?xml version="1.0" encoding="utf-8" ?>
<!-- Task de red: descarga los canales en vivo del portal Xtream en un hilo
     aparte (Roku exige que la red no bloquee el hilo de la interfaz). -->
<component name="ContentLoader" extends="Task">
  <interface>
    <field id="serverUrl" type="string" />
    <field id="username" type="string" />
    <field id="password" type="string" />
    <field id="content" type="node" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ContentLoader.brs" />
  <script type="text/brightscript" uri="pkg:/source/Xtream.brs" />
</component>

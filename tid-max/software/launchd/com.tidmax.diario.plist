<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tidmax.diario</string>

  <!-- Corre el wrapper que sincroniza + arma reporte + envía el mensaje con link. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/carlosmorenoaguilar/Cosas-Carlos/tid-max/software/tid_diario.sh</string>
  </array>

  <!-- Horas (hora LOCAL de tu Mac): 7:00 mañana, 17:00 tarde, 22:00 noche.
       Cambia Hour/Minute a lo que quieras. Si tu Mac está dormida a esa hora,
       launchd corre el trabajo al despertar. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/carlosmorenoaguilar/Cosas-Carlos/tid-max/software/publico/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/carlosmorenoaguilar/Cosas-Carlos/tid-max/software/publico/launchd.err.log</string>
</dict>
</plist>

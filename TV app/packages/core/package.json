{
  "name": "@tvapp/core",
  "version": "0.1.0",
  "description": "Núcleo compartido de la TV app: parser M3U y cliente Xtream Codes, sin dependencias de plataforma.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}

# ==========================================================
#  Investment Copilot — variables de entorno (EJEMPLO)
#  Copia este archivo a `.env` y rellena tus valores reales.
#  NUNCA subas el archivo .env real al repositorio.
# ==========================================================

# --- Base de datos (Día 1 completo / Docker) ---
DATABASE_URL=postgresql://postgres:securepassword@db:5432/copilot
REDIS_URL=redis://redis:6379/0

# --- Exchange de datos de mercado ---
# Exchanges a intentar en orden (el primero que responda gana).
# Binance suele estar geo-bloqueado en algunos servidores/IP en la nube;
# por eso incluimos alternativas públicas que no requieren API key para OHLCV.
EXCHANGE_IDS=binance,kraken,coinbase,kucoin

# --- Telegram (reemplaza a WhatsApp para el MVP) ---
TELEGRAM_BOT_TOKEN=pega_tu_token_de_BotFather
TELEGRAM_CHAT_ID=pega_tu_chat_id

# --- Parámetros del sistema ---
QUOTE_CURRENCY=USDT
TIMEFRAME=1d
HISTORY_YEARS=3
KILL_SWITCH=false

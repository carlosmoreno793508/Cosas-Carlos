# WHOOP — credenciales de la app "GAEL SYNC"
# Copia este archivo a  .env  y rellena los valores.
# NUNCA subas el .env real al repo (ya esta ignorado en .gitignore).

# Del portal developer-dashboard.whoop.com  ->  app  ->  Credentials
WHOOP_CLIENT_ID=pega-aqui-el-client-id
WHOOP_CLIENT_SECRET=pega-aqui-el-client-secret

# Debe coincidir EXACTO con el Redirect URL registrado en la app de WHOOP.
WHOOP_REDIRECT_URI=http://localhost:8765/callback

# Lo genera whoop_auth.py automaticamente (dejalo vacio la primera vez).
WHOOP_REFRESH_TOKEN=
